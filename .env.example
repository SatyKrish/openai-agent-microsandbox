# Copy to .env and fill in the key. Plain KEY=VALUE lines (kubectl env-file syntax).
# Only the harness reads these: `make secrets` puts them in the openai-creds Secret
# mounted by the harness pod. The sandbox worker never receives them.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-terra

# Optional OTLP tracing (http/protobuf, port 4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger.sre-system.svc:4318
